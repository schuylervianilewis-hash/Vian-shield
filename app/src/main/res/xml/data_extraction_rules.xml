<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The profile blob is tied to an Android Keystore key and cannot be restored
             independently on another installation/device. -->
        <exclude domain="sharedpref" path="vianshield_wireguard_profiles_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Prevent transferring encrypted profile data without its non-exportable key. -->
        <exclude domain="sharedpref" path="vianshield_wireguard_profiles_v1.xml" />
    </device-transfer>
</data-extraction-rules>
